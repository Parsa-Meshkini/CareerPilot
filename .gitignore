# --- secrets: never commit ---
.env
.env.*
!.env.example
config.local.json
*.pem
*.key
credentials*.json
client_secret*.json
token*.json
secrets/

# --- Java / Maven ---
target/
*.class
*.log
hs_err_pid*

# --- local runtime data (H2 database files, stored documents) ---
data/
*.mv.db
*.trace.db

# --- Python (documentation tooling only: UML render, report build) ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Node (extension tests) ---
node_modules/

# --- personal / sample user data (keep real resumes and emails out of git) ---
data/private/
*.eml
!samples/emails/*.eml

