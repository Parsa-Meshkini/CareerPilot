<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.careerpilot</groupId>
  <artifactId>careerpilot</artifactId>
  <version>2.0.0</version>
  <packaging>pom</packaging>
  <name>CareerPilot</name>
  <description>Adaptive AI career and application management agent (EECS 3311 Stage 2, Java)</description>

  <modules>
    <module>careerpilot-core</module>
    <module>careerpilot-server</module>
    <module>careerpilot-cli</module>
    <module>careerpilot-gui</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <picocli.version>4.7.6</picocli.version>
    <javafx.version>21.0.5</javafx.version>
    <pdfbox.version>3.0.3</pdfbox.version>
    <poi.version>5.3.0</poi.version>
    <json-schema.version>1.5.2</json-schema.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.careerpilot</groupId>
        <artifactId>careerpilot-core</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
