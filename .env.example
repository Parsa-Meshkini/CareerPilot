# CareerPilot environment template. Copy to .env and fill in locally. NEVER commit .env.
# Stage 1: placeholder values only; used from Stage 2 onward.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://careerpilot:careerpilot@postgres:5432/careerpilot
REDIS_URL=redis://redis:6379/0

# Object storage (MinIO in development, any S3-compatible service in production)
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_BUCKET=careerpilot-private
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# LLM provider abstraction: gemini | openai | mock
LLM_PROVIDER=mock
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_USER_DAILY_TOKEN_BUDGET=200000
LLM_RUN_TOKEN_BUDGET=40000

# Gmail OAuth (Google Cloud project in "Testing" status for the course)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/email/oauth/callback
EMAIL_AUTO_APPLY_THRESHOLD=0.85

# Encryption key for stored OAuth refresh tokens (Fernet, 32-byte urlsafe base64)
CREDENTIAL_VAULT_KEY=

# Feature flags
FEATURE_LINKEDIN_EXTRACTION=false
FEATURE_AUTO_TRIAGE=true
