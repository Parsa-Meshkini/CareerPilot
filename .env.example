# .env.example - contains NO real credentials.
# Copy to .env (cp .env.example .env) and fill in your own values locally.
# .env is git-ignored; never commit it.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Leave empty to use the bundled SQLite database (backend/db.sqlite3).
# Example for PostgreSQL: postgres://careerpilot:careerpilot@localhost:5432/careerpilot
DATABASE_URL=

# ---- LLM provider ----
# LLM_PROVIDER: gemini | openai_compatible | mock
#   gemini            -> Google Gemini API (free tier works), e.g. LLM_MODEL=gemini-2.5-flash
#   openai_compatible -> any OpenAI-style endpoint (OpenAI, Groq, OpenRouter...);
#                        set LLM_BASE_URL, e.g. https://api.groq.com/openai/v1
#   mock              -> offline deterministic provider used by the test suite
LLM_PROVIDER=gemini
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_USER_DAILY_TOKEN_BUDGET=200000
LLM_RUN_TOKEN_BUDGET=40000

# ---- Email ----
EMAIL_AUTO_APPLY_THRESHOLD=0.85

# ---- Feature flags ----
FEATURE_AUTO_TRIAGE=true
FEATURE_LINKEDIN_EXTRACTION=false
