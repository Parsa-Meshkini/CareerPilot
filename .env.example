# .env.example - contains NO real credentials.
# Copy to .env (cp .env.example .env) in the repository root and fill in your own values locally.
# .env is git-ignored; never commit it.

# ---- LLM provider ----
# LLM_PROVIDER: gemini | openai_compatible | mock
#   gemini            -> Google Gemini API (free tier works), e.g. LLM_MODEL=gemini-2.5-flash
#   openai_compatible -> any OpenAI-style endpoint (OpenAI, Groq, OpenRouter...);
#                        set LLM_BASE_URL, e.g. https://api.groq.com/openai/v1
#   mock              -> offline deterministic provider used by the automated tests
LLM_PROVIDER=gemini
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_USER_DAILY_TOKEN_BUDGET=200000
LLM_RUN_TOKEN_BUDGET=40000

# ---- Storage (optional) ----
# Default: an H2 database and stored documents under ~/.careerpilot, shared by the GUI, CLI and server.
# Any JDBC URL works, for example PostgreSQL: jdbc:postgresql://localhost:5432/careerpilot
# DATABASE_URL=
# DATABASE_USER=sa
# DATABASE_PASSWORD=
# STORAGE_ROOT=

# ---- Email ----
EMAIL_AUTO_APPLY_THRESHOLD=0.85

# ---- Feature flags ----
FEATURE_AUTO_TRIAGE=true
FEATURE_LINKEDIN_EXTRACTION=false

# ---- REST server (Chrome extension) ----
SERVER_PORT=8000
