    <panel_attributes>&lt;&lt;template&gt;&gt;
/DocumentGenerator/
--
#llmClient: LLMClient
#contextBuilder: ContextBuilder
#guard: FabricationGuard
#renderer: DocumentRenderer
--
+generate(userId: UUID, applicationId: UUID): List&lt;GeneratedDocument&gt; {leaf}
/#promptKey(): String/
/#buildPromptVariables(ctx: CandidateContext, job: JobPosting, analysis: JobAnalysis): Map/
/#outputSchema(): JsonSchema/
#verify(content: Map, ctx: CandidateContext): VerificationReport
/#render(content: Map): List&lt;RenderedFile&gt;/
-persist(files: List&lt;RenderedFile&gt;, applicationId: UUID): List&lt;GeneratedDocument&gt;</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
